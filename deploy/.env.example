# Copy to deploy/.env and fill in. Docker Compose reads it automatically,
# because the compose file lives in this directory.
#
#   cp deploy/.env.example deploy/.env
#   $EDITOR deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d --force-recreate
#
# Why a file rather than `export`: a container reads its environment once,
# when it is created. An export in one terminal and a `docker compose up` in
# another produce a container configured from neither - which looks exactly
# like a wrong key, a wrong model, or a wrong endpoint, and is none of them.
# A file has no such ambiguity, and `docker compose config` will show you
# what the container is actually going to get.
#
# deploy/.env is gitignored. This example file is not - keep secrets out of it.

# --- the model -----------------------------------------------------------
# Any OpenAI-compatible endpoint. Keys are usually region-bound: a DashScope
# key made in the Beijing console returns 401 on the Singapore host and vice
# versa, and the message blames the key rather than the region.
#
#   Singapore  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Beijing    https://dashscope.aliyuncs.com/compatible-mode/v1
#   local      http://host.docker.internal:11434/v1        (Ollama)
#   scripted   http://host.docker.internal:11435/v1        (scripts/demo_model.py)
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
# qwen-plus is verified to work on this account, with tool calling. Stronger,
# in order, all on the same endpoint: qwen-max, then qwen3-max. Change this,
# run `docker compose -f deploy/docker-compose.yml up -d --force-recreate`,
# and check `curl localhost:8000/health` - it reports the model it is running,
# so a container that did not restart is visible.
QWEN_MODEL=qwen-plus

# Ask the model to think before answering, where it can. Recorded in the
# trace and shown by scripts/show_history.py as THINKS. Off by default: it
# requires a streaming request, costs reasoning tokens on every call, and not
# every model accepts the flag.
QWEN_ENABLE_THINKING=false

# Check a model before committing to it. It reports both whether the key may
# call it and whether it returns a tool call at all - a model that answers in
# prose cannot drive this system and fails silently:
#
#   python3 scripts/check_model.py qwen-plus --embedding text-embedding-v3

# --- embeddings ----------------------------------------------------------
# Must return EMBEDDING_DIM values. The schema fixes that as vector(1024), so
# a different width is a migration and a re-embedding of every row.
QWEN_EMBED_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# Leave empty to use the chat endpoint above. Set them to run embeddings
# somewhere else entirely - a second server, or another provider whose API is
# OpenAI-compatible:
#
#   EMBED_API_URL=https://api.cohere.ai/compatibility/v1
#   QWEN_EMBED_MODEL=embed-multilingual-v3.0
EMBED_API_URL=
EMBED_API_KEY=

# --- the database --------------------------------------------------------
# app_authenticator is NOINHERIT and holds nothing on its own; each pool runs
# SET ROLE to become the agent it serves. See seeds/003_roles.sql.
#
# This password is the development one, and it is in the repository twice
# already - in seeds/003_roles.sql, which creates the role, and in
# docker-compose.yml. It is here for the same reason: so a fresh checkout
# starts. Change it for anything reachable by anyone else, and change it in
# the seed too, or the seed will recreate the role with this one.
PG_USER=app_authenticator
PG_PASSWORD=dev_authenticator

# --- pgvector ------------------------------------------------------------
# '<=>' cosine, '<->' L2, '<#>' inner product. Interpolated into SQL, so it is
# validated at startup rather than parameterised - and it reaches the model's
# filter guidance too, so the operator it is told to write is the one the
# index was built for.
DIST_OP=<=>

# --- what a failure tells the caller -------------------------------------
# A 500 body names the exception by default: "CacheError: Extra data: line 1
# column 9" has been the whole diagnosis more than once, and the alternative
# sends whoever is debugging to the container logs for every failure.
#
# It does leak. A DatabaseError carries the SQL that failed, which describes
# the schema. Set this to false for any deployment reachable by someone who
# should not be reading the schema - the log keeps the full message either way,
# and the response carries the request id to find it by.
HTTP_ERROR_DETAIL=true

# --- logging -------------------------------------------------------------
# DEBUG adds the SQL of every query, the conversation window sizes, and the
# model's own reasoning where the model returns it. INFO is one line per
# model call, per tool call and per turn, which is what to run with.
LOG_LEVEL=INFO

# text to read, json to ship somewhere that parses it.
LOG_FORMAT=text

# --- limits --------------------------------------------------------------
# How many model calls one question may take before the loop stops on its own
# and says so. About seven is a real question; past twelve it is not
# converging, and stopping costs less than continuing to pay for it.
MAX_LOOP_ITERATIONS=12
